# API (required for dev)
# VITE_API_BASE_URL=http://localhost:3000/api

# WhatsApp UI mode (build-time) — align with backend TWILIO_WHATSAPP_DISABLED / WHATSAPP_QR_ENABLED
# twilio = original Twilio page at /dashboard/whatsapp (default)
# qr     = QR-only flow at /dashboard/whatsapp; Twilio page not linked
# both   = Twilio at /dashboard/whatsapp + QR at /dashboard/whatsapp-qr
VITE_WHATSAPP_UI=twilio

# Analytics / conversion tracking (all optional — code falls back to the
# production IDs baked into the app if these are unset). Set them to override
# per environment, e.g. to point staging at a separate GA4 property.
# GA4 Measurement ID (falls back to G-WTDN8QJ9CM)
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Ads Sign-up conversion action "AW-XXXX/label" (secondary conversion)
# VITE_ADS_SIGNUP_CONVERSION=AW-17836518151/XXXXXXXX
# Google Ads Purchase conversion action "AW-XXXX/label" (the primary conversion)
# VITE_ADS_PURCHASE_CONVERSION=AW-17836518151/XXXXXXXX

# Exit-intent "$7 activation fee" offer. The live $7 Paddle price id is baked in
# as the production default (src/utils/offer.js). Set this only to override it per
# environment (e.g. a sandbox price id for staging). Claiming the popup offer
# makes checkout use this price for the activation fee instead of $97.
# VITE_PADDLE_SETUP_PRICE_7=pri_xxxxxxxxxxxxxxxxxxxxxxxxx
# Force-show the popup for design review (1 = on). Not needed in production.
# VITE_EXIT_OFFER_PREVIEW=1
