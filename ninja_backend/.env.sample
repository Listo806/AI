# ============================================
# Ninja Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Set to true to temporarily disable subscription/CRM enforcement guards
SUBSCRIPTION_ENFORCEMENT_DISABLED=false

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/ninja_db
DATABASE_URL=postgresql://user:password@localhost:5432/ninja_db

# ============================================
# JWT Authentication
# ============================================
# Generate strong random secrets for production
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Stripe Integration (Milestone 3)
# ============================================
# Get these from Stripe Dashboard
# https://dashboard.stripe.com/
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
# Options: your-stripe-webhook-secret-from-dashboard

# ============================================
# Mapbox Integration (Milestone 4)
# ============================================
# Get your access token from Mapbox Account
# https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# ============================================
# WhatsApp API Integration (Milestone 4)
# ============================================
# WhatsApp Business API credentials
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_API_URL=https://api.whatsapp.com

# ============================================
# AI Service Integration (Milestone 4)
# ============================================
# OpenAI
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
AI_MODEL=gpt-4o-mini

# Anthropic
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# AI_MODEL=claude-3-5-sonnet-20241022

# ============================================
# Cloud Storage (Milestone 4)
# ============================================
# AWS S3 or compatible storage
CLOUD_STORAGE_BUCKET=your-bucket-name
CLOUD_STORAGE_REGION=us-east-1
CLOUD_STORAGE_ACCESS_KEY=your-access-key
CLOUD_STORAGE_SECRET_KEY=your-secret-key

# ============================================
# Frontend Configuration
# ============================================
# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# ============================================
# Web Push Notification (Milestone 4)
# ============================================
# VAPID KEYS
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com
# ============================================
# WhatsApp QR (Baileys) – Enterprise spec
# ============================================
# Disable Twilio WhatsApp without deleting code; QR module replaces dashboard path
TWILIO_WHATSAPP_DISABLED=false
# Enable QR module features when Baileys is wired
WHATSAPP_QR_ENABLED=false
# Redis auth namespace baileys:auth:{userId}
REDIS_URL=

# ============================================
# Site Assist (Webflow embed — public API, not CRM leads)
# ============================================
# Optional: require X-Site-Assist-Key header on POST /api/public/site-assist/turn
# SITE_ASSIST_API_KEY=
# Public listing frontend (no trailing slash), e.g. Netlify app or Webflow site
SITE_ASSIST_PUBLIC_ORIGIN=https://www.cortexaaicrm.com
# Path template; {id} = property UUID (default: /listings/{id})
SITE_ASSIST_PROPERTY_PATH=/listings/{id}
# Optional JSON array for handoff: [{"label":"WhatsApp","url":"https://wa.me/..."},{"label":"Email","url":"mailto:..."}]
# SITE_ASSIST_HANDOFF_LINKS=

# ============================================
# Notes
# ============================================
# - For local development, you can use default values
# - For production, change all secrets and use strong passwords
# - Never commit .env file to version control
# - Use different values for staging and production environments
